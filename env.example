# Copy to .env and fill in. Used by scripts/beer_sync.py for uploads.

# S3 bucket that stores beer photos + manifest.json (from terraform output bucket_name)
S3_BUCKET=your-beer-bucket-name

# AWS region the bucket lives in
AWS_REGION=ap-southeast-2

# Uploader IAM credentials (from terraform output uploader_access_key_id / _secret_access_key)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CloudFront URL that serves the bucket (e.g. https://cdn.beer.example.com)
CLOUDFRONT_URL=https://cdn.beer.example.com

# Local folder holding photos to sync (flat — all photos named per the convention)
LOCAL_PHOTOS_DIR=./photos
