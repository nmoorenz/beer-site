# Copy to terraform.tfvars and edit.

# Globally-unique S3 bucket name for beer photos
bucket_name = "nmoore-beer-photos"

# AWS region
aws_region = "ap-southeast-6"

# Local AWS CLI profile
aws_profile = "your-aws-profile"

# CDN subdomain that serves photos + manifest
cdn_domain = "cdn.beer.example.com"

# Site origin(s) allowed to fetch from the bucket via CORS
allowed_origins = ["https://beer.example.com"]
